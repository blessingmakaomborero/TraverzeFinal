{
  "kind": "collectionType",
  "collectionName": "feedbacks",
  "info": {
    "singularName": "feedback",
    "pluralName": "feedbacks",
    "displayName": "Feedback"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "rating":  { "type": "integer", "min": 1, "max": 5, "required": true },
    "comment": { "type": "text" },
    "nps":     { "type": "integer", "min": 0, "max": 10 },
    "booking": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::booking.booking",
      "inversedBy": "feedbacks"
    },
    "enquiry": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tams-enquiry.tams-enquiry"
    },
    "customer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::customer-profile.customer-profile"
    }
  }
}

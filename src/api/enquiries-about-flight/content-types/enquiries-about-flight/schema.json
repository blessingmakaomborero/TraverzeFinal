{
  "kind": "collectionType",
  "collectionName": "enquiries_about_flights",
  "info": {
    "singularName": "enquiries-about-flight",
    "pluralName": "enquiries-about-flights",
    "displayName": "EnquiriesAboutFlights",
    "description": "Option A manual flight enquiry → quote → ticket pipeline"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "enquiryRef": {
      "type": "string",
      "unique": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "New",
        "Under Review",
        "Searching",
        "Quotation Sent",
        "Awaiting Response",
        "Accepted",
        "Awaiting Payment",
        "Ticket Issued",
        "Cancelled",
        "Closed"
      ],
      "default": "New"
    },
    "FirstName": {
      "type": "string"
    },
    "LastName": {
      "type": "string"
    },
    "PhoneNumber": {
      "type": "string"
    },
    "Message": {
      "type": "richtext"
    },
    "Email": {
      "type": "email"
    },
    "Children": {
      "type": "integer"
    },
    "Adults": {
      "type": "integer"
    },
    "Infants": {
      "type": "integer"
    },
    "FlightClass": {
      "type": "string"
    },
    "SecondFilghtClass": {
      "type": "string"
    },
    "Terms_Conditions": {
      "type": "boolean"
    },
    "TripType": {
      "type": "enumeration",
      "enum": ["one-way", "round-trip", "multi-city", "One Way", "Two Way", "Multicity"]
    },
    "OtherCitiies": {
      "type": "richtext"
    },
    "DepartureAirport": {
      "type": "string"
    },
    "ArrivalAirport": {
      "type": "string"
    },
    "SecondArrivalAirport": {
      "type": "string"
    },
    "SecondDepartureAirport": {
      "type": "string"
    },
    "DepartureDate": {
      "type": "date"
    },
    "ReturnDate": {
      "type": "date"
    },
    "SecondDepartureDate": {
      "type": "date"
    },
    "assignedAgent": {
      "type": "string"
    },
    "searchNotes": {
      "type": "text"
    },
    "agentNotes": {
      "type": "text"
    },
    "quotationAmount": {
      "type": "decimal"
    },
    "quotationCurrency": {
      "type": "string",
      "default": "USD"
    },
    "quotationDetails": {
      "type": "text"
    },
    "quotationSentAt": {
      "type": "datetime"
    },
    "acknowledgementSentAt": {
      "type": "datetime"
    },
    "tamsEnquiryRef": {
      "type": "string"
    },
    "changeLog": {
      "type": "json"
    },
    "contactPreference": {
      "type": "string"
    }
  }
}
